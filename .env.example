# Copy to .env on the server (beside manage.py) and fill in. Never upload or commit the real .env.
# cPanel's "Environment variables" box sets the same names for the web app; .env also reaches the Terminal.

DJANGO_SECRET_KEY=paste-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=surveillance.rhduer.online
DJANGO_HTTPS=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://surveillance.rhduer.online
# DJANGO_DEBUG=1

# SQLite (db.sqlite3 here) needs nothing. For MySQL, pip install PyMySQL and set:
# DB_ENGINE=mysql
# DB_NAME=cpaneluser_surveillance
# DB_USER=cpaneluser_surveillance
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Defaults are data/ and private_media/ inside the app folder.
# DATA_DIR=/home/cpaneluser/surveillance-data
# PRIVATE_DIR=/home/cpaneluser/surveillance-private

# SMS reminders to district officers (AFP 60-day follow-up) through Fish Africa. Leave blank to turn SMS off.
# Fish Africa dashboard > Settings > Applications > Default App. The sender ID (at most 11 characters) must be approved.
LETSFISH_APP_ID=
LETSFISH_APP_SECRET=
LETSFISH_SENDER_ID=
